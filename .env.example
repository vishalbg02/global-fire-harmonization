# Copy to .env and fill in. NEVER commit .env.

# Free NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Local data directory (defaults to ./data)
DATA_DIR=./data

# Folder with the data products read by the API (no secret). Default: data/products.
# For development use the SYNTHETIC fixtures: data/fixtures/v0.1.0
PRODUCTS_DIR=
