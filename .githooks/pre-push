#!/bin/sh
# Local safety net: blocks accidental pushes to main from this clone.
# Enable once per clone:   git config core.hooksPath .githooks
# This is NOT enforcement (bypassable with --no-verify). See docs/TEAM_WORKFLOW.md §10.
# Project Lead bookkeeping commits only (D-018):   ALLOW_MAIN_PUSH=1 git push
#
# Git LFS (D-027): core.hooksPath replaces .git/hooks, so Git LFS's own pre-push hook
# would never run and LFS files would not be uploaded. This hook forwards the push to
# `git lfs pre-push` after the main-branch check.

input=$(cat)

printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "pre-push: direct pushes to 'main' are not allowed." >&2
    echo "Push your task branch and open a Pull Request instead (CONTRIBUTING.md)." >&2
    exit 1
  fi
done || exit 1

if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@" || exit 1
elif git ls-files -- 'data/products/*.parquet' 'data/products/**/*.parquet' | grep -q .; then
  echo "pre-push: Git LFS is not installed, but this repository stores products in LFS (D-027)." >&2
  echo "Install it (macOS: brew install git-lfs; Windows: Git for Windows) and run: git lfs install" >&2
  exit 1
fi
exit 0
